<mxfile host="app.diagrams.net" modified="2026-07-26T00:00:00.000Z" agent="draw.io" version="30.3.6" type="device">
  <diagram id="readme-game-studio-skill-map" name="README game studio skill map">
    <mxGraphModel dx="1240" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="800" background="#FFFFFF" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Four agent skills for building a game with AI coding" style="text;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontStyle=1;fontColor=#111827;spacing=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Start from taste, a pitch, or a repo already in progress &#8212; then work in playable milestones, each one checked by playing the build" style="text;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#4B5563;spacing=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="72" width="1080" height="22" as="geometry" />
        </mxCell>
        <mxCell id="direction-panel" value="1 &#183; game-direction" style="swimlane;startSize=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=SF Mono,Menlo,Consolas,monospace;fontSize=16;fontStyle=1;fontColor=#312E81;fillColor=#EEF2FF;swimlaneFillColor=#F8FAFC;strokeColor=#A5B4FC;spacing=10;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="152" width="360" height="256" as="geometry" />
        </mxCell>
        <mxCell id="direction-does" value="Turn taste into a direction the creator recognizes as theirs &#8212; or audit the one that already exists." style="text;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;fontSize=14;fontColor=#374151;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;html=1;" vertex="1" parent="direction-panel">
          <mxGeometry x="24" y="68" width="312" height="56" as="geometry" />
        </mxCell>
        <mxCell id="direction-out" value="&lt;font style=&quot;font-size:10px;color:#6366F1;&quot;&gt;WHAT YOU GET&lt;/font&gt;&lt;br&gt;&lt;b&gt;A creative brief and the first prototype to build&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;concept slate &#183; player role &#183; hard noes&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="direction-panel">
          <mxGeometry x="24" y="136" width="312" height="96" as="geometry" />
        </mxCell>
        <mxCell id="production-panel" value="2 &#183; game-production" style="swimlane;startSize=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=SF Mono,Menlo,Consolas,monospace;fontSize=16;fontStyle=1;fontColor=#312E81;fillColor=#EEF2FF;swimlaneFillColor=#F8FAFC;strokeColor=#A5B4FC;spacing=10;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="152" width="360" height="256" as="geometry" />
        </mxCell>
        <mxCell id="production-does" value="Build the smallest thing that answers the riskiest open question, and implement it without design drift." style="text;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;fontSize=14;fontColor=#374151;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;html=1;" vertex="1" parent="production-panel">
          <mxGeometry x="24" y="68" width="312" height="56" as="geometry" />
        </mxCell>
        <mxCell id="production-out" value="&lt;font style=&quot;font-size:10px;color:#6366F1;&quot;&gt;WHAT YOU GET&lt;/font&gt;&lt;br&gt;&lt;b&gt;A build that runs, played and captured&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;every milestone is something you can play, not a task list&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="production-panel">
          <mxGeometry x="24" y="136" width="312" height="96" as="geometry" />
        </mxCell>
        <mxCell id="review-panel" value="3 &#183; game-review" style="swimlane;startSize=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=SF Mono,Menlo,Consolas,monospace;fontSize=16;fontStyle=1;fontColor=#312E81;fillColor=#EEF2FF;swimlaneFillColor=#F8FAFC;strokeColor=#A5B4FC;spacing=10;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="152" width="360" height="256" as="geometry" />
        </mxCell>
        <mxCell id="review-does" value="Judge the game, not the report &#8212; design, build, narrative, accessibility, and release claims." style="text;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;fontSize=14;fontColor=#374151;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;html=1;" vertex="1" parent="review-panel">
          <mxGeometry x="24" y="68" width="312" height="56" as="geometry" />
        </mxCell>
        <mxCell id="review-out" value="&lt;font style=&quot;font-size:10px;color:#6366F1;&quot;&gt;WHAT YOU GET&lt;/font&gt;&lt;br&gt;&lt;b&gt;Milestone sign-off: READY / CONCERNS / NOT READY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;evidence before opinion &#183; strictest finding wins&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="review-panel">
          <mxGeometry x="24" y="136" width="312" height="96" as="geometry" />
        </mxCell>
        <mxCell id="knowledge-panel" value="4 &#183; game-knowledge &#8212; the field manual the three skills consult mid-work" style="swimlane;startSize=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=SF Mono,Menlo,Consolas,monospace;fontSize=16;fontStyle=1;fontColor=#92400E;fillColor=#FEF3C7;swimlaneFillColor=#FFFBEB;strokeColor=#FCD34D;spacing=10;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="488" width="1160" height="180" as="geometry" />
        </mxCell>
        <mxCell id="knowledge-ask" value="&lt;b&gt;Ask it mid-work&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;18 routing signals: &quot;make it punchier&quot;, pricing, Next Fest, a first contractor, burnout&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#FDE68A;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="knowledge-panel">
          <mxGeometry x="24" y="68" width="352" height="88" as="geometry" />
        </mxCell>
        <mxCell id="knowledge-rule" value="&lt;b&gt;Get a rule with its source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;16 distilled docs; every number carries a dated citation, and folklore stays labeled unverified&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#FDE68A;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="knowledge-panel">
          <mxGeometry x="404" y="68" width="352" height="88" as="geometry" />
        </mxCell>
        <mxCell id="knowledge-deep" value="&lt;b&gt;Read the primary work&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#4B5563;&quot;&gt;68-file research corpus in 6 lanes, each lane shipping its own confidence manifest&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#FDE68A;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;html=1;" vertex="1" parent="knowledge-panel">
          <mxGeometry x="784" y="68" width="352" height="88" as="geometry" />
        </mxCell>
        <mxCell id="human-authority" value="&lt;b&gt;The calls that stay yours&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;&lt;font style=&quot;color:#4B5563;&quot;&gt;which concept to chase &#183; when the direction locks &#183; when a stage is really done &#183; what ships, at what price, and what you promise publicly&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;fontFamily=Inter,SF Pro Display,-apple-system,system-ui,Segoe UI,Roboto;spacing=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.4;fontColor=#111827;fontSize=13;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="698" width="1160" height="58" as="geometry" />
        </mxCell>
        <mxCell id="direction-to-production" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6366F1;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;html=1;" edge="1" parent="1" source="direction-panel" target="production-panel">
